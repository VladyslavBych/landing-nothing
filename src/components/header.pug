header.c-header
  .o-container
    .c-header__bar
      a.c-header__logo(href='#', aria-label='Nothing home')
        +icon('logo', 172, 24)

      .c-header__actions
        a.c-header__phone(href='tel:+12345555555', aria-label='Call us +1 234 555-55-55')
          span.c-header__phone-number +1 234 555-55-55
          +icon('phone', 24)

        label.c-header__burger(
          for='menu-toggle',
          role='button',
          tabindex='0',
          aria-label='Open menu'
        )
          +icon('burger', 24).c-header__burger-default
          +icon('burger-hover', 24).c-header__burger-hover