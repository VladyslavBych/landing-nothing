section.c-recommended#recommended
    .o-container
        h2.c-section-title.c-recommended__title Recommended

        ul.o-grid.c-recommended__list
            each product in recommendedProducts
                li.c-recommended__item
                    article.c-product-card
                        .c-product-card__media
                            +picture(
                                product.image,
                                product.alt,
                                720,
                                720,
                                true,
                                '(min-width: 1260px) 324px, (min-width: 744px) 392px, 280px'
                            ).c-product-card__img
                        h3.c-product-card__title= product.name
                        p.c-product-card__desc= product.description
                        p.c-product-card__price= product.price