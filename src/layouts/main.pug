include ../mixins/icon.pug
include ../mixins/picture.pug

block data

doctype html
html(lang='en')
  head
    block meta
      meta(charset='UTF-8')
      meta(name='viewport', content='width=device-width, initial-scale=1')
      meta(
        name='description',
        content='Nothing — London-based tech company crafting intuitive, seamlessly connected products.'
      )
    block title
      title Nothing — Bring joy back to the everyday
    include ../includes/fonts.pug
    block styles
      link(rel='stylesheet', href='/src/styles/main.scss')
  body
    a.u-visually-hidden(href='#main') Skip to content
    include ../includes/icons.pug
    input.u-visually-hidden#menu-toggle(type='checkbox', aria-hidden='true')
    include ../components/header.pug
    include ../components/menu.pug
    main#main
      block content