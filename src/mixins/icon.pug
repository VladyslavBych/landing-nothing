mixin icon(name, size = 24)
  svg.c-icon(
    width=size,
    height=size,
    aria-hidden='true',
    focusable='false'
  )&attributes(attributes)
    use(href=`#icon-${name}`)
    mixin icon(name, width = 24, height = width)
      svg.c-icon(
        width=width,
        height=height,
        aria-hidden='true',
        focusable='false'
      )&attributes(attributes)
        use(href=`#icon-${name}`)